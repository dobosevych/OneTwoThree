POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SEED=true
# Host ports (change if already taken on your machine)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# AWS deployment (`make aws-deploy`). .env is gitignored — never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
