# Optional overrides for the backend stack. Copy to infra/backend.params.env (gitignored) and edit.
# Each line is a CloudFormation parameter of infra/backend.yaml, passed by `make aws-backend-deploy`.
# CorsOrigins is set by the Makefile (CORS_LOCAL + the frontend's origins); don't set it here.

Seed=true
MemorySize=512
# Timeout=30
# 0 = the database pauses when idle (you pay only for storage); 0.5 or more keeps it warm.
# DbMinCapacity=0
# DbEngineVersion=16.14
# DbMaxCapacity=1
# DbSecondsUntilAutoPause=300
# DbBackupRetentionDays=7
